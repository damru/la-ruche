{
  "name": "laruche-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "La Ruche — Frontend Vue 3",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "i18n:extract": "vue-i18n-extract report --vue 'src/**/*.vue' --locales 'src/i18n/locales/**/*.json'"
  },
  "dependencies": {
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "pinia": "^3.0.4",

    "@tanstack/vue-query": "^5.99.1",

    "axios": "^1.15.0",

    "@vueuse/core": "^14.2.1",

    "vue-i18n": "^11.3.2",

    "radix-vue": "^1.9.17"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vue-tsc": "^3.2.6",
    "@types/node": "^25.6.0",
    "unplugin-vue-components": "^32.0.0",
    "unplugin-auto-import": "^21.0.0",
    "@intlify/unplugin-vue-i18n": "^11.0.7"
  }
}
