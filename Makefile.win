# ── La Ruche — Makefile (PowerShell) ─────────────────────────────
# Usage: make -f Makefile.win <target>   (from the project root, PowerShell)
# Requires: GNU make + PowerShell Core (pwsh) in PATH

SHELL     := pwsh
.SHELLFLAGS := -NoProfile -NonInteractive -Command

# Variables
DB_URL      := postgres://laruche:laruche@localhost:5432/laruche
DB_URL_TEST := postgres://laruche:laruche@localhost:5432/laruche_test

.PHONY: help dev dev-frontend dev-full build build-frontend \
        test test-integration test-all test-frontend \
        lint lint-fix check \
        migrate migrate-test migrate-revert sqlx-prepare \
        docker docker-up docker-down docker-prod docker-logs \
        clean install-tools setup setup-hooks commit fmt

help: ## Show this help
	Select-String -Path Makefile.win -Pattern '^[a-zA-Z_-]+:.*?##' | ForEach-Object { \
	  if ($$_.Line -match '^([a-zA-Z_-]+):.*?##\s*(.*)') { \
	    '  {0,-22}{1}' -f $$Matches[1], $$Matches[2] \
	  } \
	}

# ── Development ───────────────────────────────────────────────────
dev: ## Start the dev environment (postgres + S3 storage + backend hot-reload)
	docker compose up -d postgres rustfs
	$(MAKE) -f Makefile.win sqlx-prepare
	Set-Location backend; bacon watch

dev-frontend: ## Start the Vue 3 frontend in dev mode
	Set-Location frontend; npm run dev

dev-full: ## Start everything (backend + frontend) — opens two windows
	Start-Process pwsh -ArgumentList '-NoExit', '-Command', "Set-Location '$$PWD'; $(MAKE) -f Makefile.win dev"
	Start-Process pwsh -ArgumentList '-NoExit', '-Command', "Set-Location '$$PWD'; $(MAKE) -f Makefile.win dev-frontend"

# ── Build ─────────────────────────────────────────────────────────
build: ## Build the release binary
	$$env:SQLX_OFFLINE = 'true'; Set-Location backend; cargo build --release

build-frontend: ## Build the frontend
	Set-Location frontend; npm run build

# ── Tests ─────────────────────────────────────────────────────────
test: ## Backend unit tests (no DB required)
	Set-Location backend; cargo test --lib

test-integration: ## Backend integration tests (requires postgres)
	$$env:DATABASE_URL = '$(DB_URL_TEST)'; Set-Location backend; cargo test --test '*'

test-all: test test-integration ## Run all tests

test-frontend: ## Frontend TypeScript type check
	Set-Location frontend; npm run typecheck

# ── Code quality ──────────────────────────────────────────────────
lint: ## Clippy + fmt check + npm lint
	Set-Location backend; cargo fmt --check; cargo clippy -- -D warnings
	Set-Location frontend; npm run lint

lint-fix: ## Format Rust and TypeScript code
	Set-Location backend; cargo fmt; cargo clippy --fix --allow-dirty
	Set-Location frontend; npm run lint -- --fix

check: ## Quick check (no full build)
	$$env:SQLX_OFFLINE = 'true'; Set-Location backend; cargo check

# ── Database ──────────────────────────────────────────────────────
migrate: ## Apply migrations
	$$env:DATABASE_URL = '$(DB_URL)'; Set-Location backend; sqlx migrate run

migrate-test: ## Apply migrations on the test DB
	$$env:DATABASE_URL = '$(DB_URL_TEST)'; Set-Location backend; sqlx migrate run

migrate-revert: ## Revert the last migration
	$$env:DATABASE_URL = '$(DB_URL)'; Set-Location backend; sqlx migrate revert

sqlx-prepare: migrate ## Generate SQLx offline metadata (.sqlx/)
	$$env:DATABASE_URL = '$(DB_URL)'; Set-Location backend; cargo sqlx prepare

# ── Docker ────────────────────────────────────────────────────────
docker: ## Build the unified image (frontend + backend + Caddy)
	docker build -t laruche:dev .

docker-up: ## Start the full stack via docker compose
	docker compose up -d --build

docker-down: ## Stop the stack
	docker compose down

docker-prod: ## Start in production mode
	docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

docker-logs: ## Tail logs for the laruche service
	docker compose logs -f laruche

# ── Utilities ─────────────────────────────────────────────────────
clean: ## Clean build artifacts
	Set-Location backend; cargo clean
	Set-Location frontend; @('dist','node_modules') | Where-Object { Test-Path $$_ } | ForEach-Object { Remove-Item -Recurse -Force $$_ }

install-tools: ## Install development tools
	cargo install sqlx-cli --no-default-features --features postgres --locked
	cargo install bacon --locked
	Set-Location frontend; npm ci

setup-hooks: ## Install git hooks (pre-commit: cargo fmt + clippy)
	git config core.hooksPath .githooks
	Write-Host 'Git hooks configured (.githooks/)' -ForegroundColor Green

setup: ## Full initial setup
	Copy-Item backend\.env.example backend\.env
	$(MAKE) -f Makefile.win setup-hooks
	docker compose up -d postgres rustfs
	Start-Sleep 3
	$(MAKE) -f Makefile.win migrate
	Write-Host "La Ruche ready — run 'make -f Makefile.win dev'" -ForegroundColor Green

fmt: ## Format Rust code (cargo fmt)
	Set-Location backend; cargo fmt

commit: ## Safe commit — runs .githooks hooks then git commit
	Get-ChildItem .githooks | ForEach-Object { & $$_.FullName }
	git commit
