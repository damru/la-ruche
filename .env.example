# ── Application ─────────────────────────────────────────────────
LA_RUCHE__APP__HOST=0.0.0.0
LA_RUCHE__APP__PORT=8080
LA_RUCHE__APP__PUBLIC_URL=http://localhost
LA_RUCHE__APP__NAME="La Ruche"

# ── Base de données ──────────────────────────────────────────────
LA_RUCHE__DB__URL=postgres://laruche:laruche@localhost:5432/laruche
LA_RUCHE__DB__MAX_CONNECTIONS=10

# ── Stockage S3 (MinIO en dev) ───────────────────────────────────
LA_RUCHE__S3__ENDPOINT_URL=http://localhost:9000
LA_RUCHE__S3__REGION=us-east-1
LA_RUCHE__S3__ACCESS_KEY_ID=minioadmin
LA_RUCHE__S3__SECRET_ACCESS_KEY=minioadmin
LA_RUCHE__S3__BUCKET_PREFIX=laruche
LA_RUCHE__S3__STAGING_BUCKET=laruche-staging
LA_RUCHE__S3__PRESIGNED_TTL_SECS=900

# ── Auth ─────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 64
LA_RUCHE__AUTH__JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
LA_RUCHE__AUTH__ACCESS_TOKEN_TTL_SECS=900
LA_RUCHE__AUTH__REFRESH_TOKEN_TTL_DAYS=30
LA_RUCHE__AUTH__INVITATION_TTL_DAYS=7
LA_RUCHE__AUTH__RESET_TOKEN_TTL_SECS=3600
LA_RUCHE__AUTH__VENDOR_TOKEN_TTL_DAYS=30
LA_RUCHE__AUTH__ARGON2_MEMORY_KB=65536
LA_RUCHE__AUTH__ARGON2_ITERATIONS=3

# ── Logs ─────────────────────────────────────────────────────────
# Niveaux : error | warn | info | debug | trace
RUST_LOG=laruche=info,tower_http=info
